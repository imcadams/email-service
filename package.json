{
  "name": "email-service",
  "version": "1.0.0",
  "description": "AWS Lambda Email Service using SES",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "predeploy": "npm run build",
    "deploy": "xcopy /E /I /Y node_modules dist\\node_modules && cd dist && powershell Compress-Archive -Path * -DestinationPath ..\\function.zip -Force",
    "test": "jest --runInBand"
  },
  "keywords": [
    "aws",
    "lambda",
    "email",
    "ses"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^20.9.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.821.0",
    "@aws-sdk/client-ses": "^3.821.0"
  }
}
